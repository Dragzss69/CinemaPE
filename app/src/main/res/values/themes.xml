<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.CinemaPE" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Main theme colors -->
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorOnPrimary">@color/black_bg_dark</item>

        <item name="android:windowBackground">@color/black_bg_dark</item>
        <item name="colorSurface">@color/black_card_dark</item>
        <item name="colorOnSurface">@color/text_main</item>

        <item name="colorPrimaryContainer">@color/black_bg_dark</item>
        <item name="colorOnPrimaryContainer">@color/orange_primary</item>
        <item name="colorSurfaceVariant">@color/black_bg_dark</item>

        <item name="colorSecondaryContainer">#26FF8C00</item> <!-- Orange with transparency -->
        <item name="colorOnSecondaryContainer">@color/orange_primary</item>

        <item name="android:statusBarColor">@color/black_bg_dark</item>
    </style>

    <style name="Theme.CinemaPE" parent="Base.Theme.CinemaPE" />

    <style name="CustomDialog" parent="Theme.Material3.Dark.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>